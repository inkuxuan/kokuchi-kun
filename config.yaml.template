discord:
  prefix: "!"
  seen_reaction_emoji: "👀"
  approval_reaction_emoji: "👍"
  fast_forward_emoji: "⏩"
  calendar_emoji: "📅"
  admin_id: 000000000000000000  # Discord User ID for the bot admin (receives OTP DMs and config warnings)

  guilds:  # List of Discord servers (guilds) the bot serves
    - guild_id: 000000000000000000      # Discord Server (Guild) ID
      group_id: "grp_00000000-0000-0000-0000-000000000000"  # VRChat group ID for this guild
      enabled: true                      # Set to false to disable new announcement requests (booked ones still post)
      channel_ids:                       # Channels to monitor for announcement requests
        - 000000000000000000
      admin_role_id: 000000000000000000  # Role ID with admin privileges
      # firestore_server_id: "custom"   # Optional: override the Firestore key for this guild (defaults to guild_id)
      # notify_online: true             # Send "Bot is online" message on startup (default: true)
      # notify_login: true              # Send "Logged into VRChat as X" message after VRChat auth (default: true)
      # notify_restoration: true        # Send restored announcements stats on startup (default: true)

openrouter:
  model: "deepseek/deepseek-v3.2"
  prompt_file: "prompt.txt"  # Path to the prompt file (relative to working directory)

scheduler:
  misfire_grace_time: 3600  # seconds - allow execution up to this many seconds late (default: 3600)

vrchat:
  heartbeat_interval: 60 # minutes

firestore:
  database: "(default)"            # Firestore database ID (use a different name for dev, e.g. "dev")
  servers_collection: "servers"    # Top-level collection for per-guild state
  shared_collection: "shared"      # Top-level collection for shared state (e.g. VRChat session)
